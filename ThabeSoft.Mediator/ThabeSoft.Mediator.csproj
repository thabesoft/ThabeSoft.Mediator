<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"
						  Version="11.0.0-preview.3.26207.106" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ThabeSoft.Mediator.Abstractions\ThabeSoft.Mediator.Abstractions.csproj" />
		<ProjectReference Include="..\ThabeSoft.Mediator.SourceGenerator\ThabeSoft.Mediator.SourceGenerator.csproj"
						  PrivateAssets="none"
						  ReferenceOutputAssembly="false"
						  OutputItemType="Analyzer" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\ThabeSoft.Mediator.SourceGenerator\bin\$(Configuration)\netstandard2.0\*.dll"
			  Pack="true"
			  PackagePath="analyzers/dotnet/roslyn4.0/cs"
			  Visible="false" />
	</ItemGroup>

</Project>
